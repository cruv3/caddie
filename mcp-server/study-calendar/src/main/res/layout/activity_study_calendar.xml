<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/schedule_screen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/calendar_background"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="20dp"
    android:paddingEnd="24dp"
    android:paddingBottom="24dp">

    <TextView
        android:id="@+id/month_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="28dp"
        android:textColor="@color/calendar_text_primary"
        android:textSize="30sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="64dp"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/today_weekday"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:maxLines="1"
                android:textColor="@color/calendar_text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/today_number"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_date_circle"
                android:gravity="center"
                android:textColor="@color/calendar_background"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/meeting_event"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:background="@drawable/bg_calendar_event"
            android:contentDescription="@string/meeting_title"
            android:minHeight="80dp"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/meeting_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/meeting_title"
                android:textColor="@color/calendar_background"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/meeting_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/calendar_background"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="64dp"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tomorrow_weekday"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:maxLines="1"
                android:textColor="@color/calendar_text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tomorrow_number"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_date_circle"
                android:gravity="center"
                android:textColor="@color/calendar_background"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/exam_event"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:background="@drawable/bg_calendar_event"
            android:contentDescription="@string/exam_title"
            android:minHeight="80dp"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/exam_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/exam_title"
                android:textColor="@color/calendar_background"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/exam_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/calendar_background"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <Space
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/create_event"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="end"
        android:background="@drawable/bg_calendar_fab"
        android:gravity="center"
        android:importantForAccessibility="no"
        android:text="@string/plus_symbol"
        android:textColor="@color/calendar_background"
        android:textSize="30sp" />

</LinearLayout>
