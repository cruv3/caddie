<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/calendar_background">

    <LinearLayout
        android:id="@+id/schedule_screen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/calendar_background"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="20dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

    <TextView
        android:id="@+id/month_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="28dp"
        android:textColor="@color/calendar_text_primary"
        android:textSize="30sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="64dp"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/today_weekday"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:maxLines="1"
                android:textColor="@color/calendar_text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/today_number"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_date_circle"
                android:gravity="center"
                android:textColor="@color/calendar_background"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/meeting_event"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:background="@drawable/bg_calendar_event"
            android:contentDescription="@string/meeting_title"
            android:minHeight="80dp"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/meeting_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/meeting_title"
                android:textColor="@color/calendar_background"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/meeting_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/calendar_background"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="64dp"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tomorrow_weekday"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:maxLines="1"
                android:textColor="@color/calendar_text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tomorrow_number"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_date_circle"
                android:gravity="center"
                android:textColor="@color/calendar_background"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/exam_event"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:background="@drawable/bg_calendar_event"
            android:contentDescription="@string/exam_title"
            android:minHeight="80dp"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/exam_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/exam_title"
                android:textColor="@color/calendar_background"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/exam_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/calendar_background"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <Space
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/create_event"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="end"
        android:background="@drawable/bg_calendar_fab"
        android:gravity="center"
        android:importantForAccessibility="no"
        android:text="@string/plus_symbol"
        android:textColor="@color/calendar_background"
        android:textSize="30sp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/detail_screen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/calendar_background"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="20dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/detail_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:textColor="@color/calendar_text_primary"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/detail_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:textColor="@color/calendar_text_secondary"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/detail_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/calendar_text_primary"
            android:textSize="20sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/calendar_name"
            android:textColor="@color/calendar_text_secondary"
            android:textSize="16sp" />

        <Space
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/edit_event"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_calendar_event"
            android:contentDescription="@string/edit_event"
            android:gravity="center"
            android:text="@string/edit_event"
            android:textColor="@color/calendar_background"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/editor_screen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/calendar_background"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="20dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/edit_meeting"
            android:textColor="@color/calendar_text_primary"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/start_time"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="32dp"
            android:background="@drawable/bg_calendar_event"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@color/calendar_background"
            android:textSize="17sp" />

        <LinearLayout
            android:id="@+id/time_choice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_calendar_event"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/hour_15"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:contentDescription="@string/hour_15"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/hour_15"
                android:textColor="@color/calendar_background"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/hour_16"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:contentDescription="@string/hour_16"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/hour_16"
                android:textColor="@color/calendar_background"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/confirm_time"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:contentDescription="@string/confirm_time"
                android:gravity="center"
                android:text="@string/confirm_time"
                android:textColor="@color/calendar_background"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>

        <Space
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/save_event"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_calendar_event"
            android:contentDescription="@string/save_event"
            android:gravity="center"
            android:text="@string/save_event"
            android:textColor="@color/calendar_background"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>

</FrameLayout>
