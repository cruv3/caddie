<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_mail_row"
    android:clickable="false"
    android:focusable="false"
    android:gravity="top"
    android:minHeight="88dp"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp"
    android:paddingVertical="10dp">

    <TextView
        android:layout_width="32dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="☆"
        android:textColor="@color/mail_secondary"
        android:textSize="22sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="8dp">

        <TextView
            android:id="@+id/mail_row_sender"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/mail_text"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/mail_row_subject"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/mail_text"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/mail_row_preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/mail_secondary"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/mail_row_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="8dp"
        android:textColor="@color/mail_secondary"
        android:textSize="12sp" />
</LinearLayout>
