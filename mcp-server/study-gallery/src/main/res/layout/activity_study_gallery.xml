<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gallery_background">

    <ScrollView
        android:id="@+id/gallery_grid"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="40dp"
            android:paddingEnd="16dp"
            android:paddingBottom="28dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/photos"
                    android:textColor="@color/gallery_text"
                    android:textSize="32sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_gallery_avatar"
                    android:gravity="center"
                    android:text="A"
                    android:textColor="@android:color/white"
                    android:textSize="17sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_gallery_search"
                android:drawableStart="@android:drawable/ic_menu_search"
                android:drawablePadding="12dp"
                android:gravity="center_vertical"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="@string/search_photos"
                android:textColor="@color/gallery_muted"
                android:textSize="16sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:layout_marginBottom="12dp"
                android:text="@string/today"
                android:textColor="@color/gallery_text"
                android:textSize="19sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="190dp"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/whiteboard_photo"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="3dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_photo_tile"
                    android:clickable="true"
                    android:clipToOutline="true"
                    android:contentDescription="@string/whiteboard_selector"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:scaleType="centerCrop"
                        android:src="@drawable/photo_whiteboard" />
                </FrameLayout>

                <ImageView
                    android:id="@+id/library_photo"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="3dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_photo_tile"
                    android:clipToOutline="true"
                    android:contentDescription="Bibliothek und Schreibtisch"
                    android:scaleType="centerCrop"
                    android:src="@drawable/photo_library" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="190dp"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/tram_photo"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="3dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_photo_tile"
                    android:clipToOutline="true"
                    android:contentDescription="Campus aus der Straßenbahn"
                    android:scaleType="centerCrop"
                    android:src="@drawable/photo_tram" />

                <ImageView
                    android:id="@+id/study_group_photo"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="3dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_photo_tile"
                    android:clipToOutline="true"
                    android:contentDescription="Lerngruppe auf dem Campus"
                    android:scaleType="centerCrop"
                    android:src="@drawable/photo_study_group" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:text="@string/yesterday"
                android:textColor="@color/gallery_text"
                android:textSize="19sp"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/gallery_detail"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/gallery_detail_background"
        android:orientation="vertical"
        android:paddingTop="24dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="18dp">

            <TextView
                android:id="@+id/back_to_gallery"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:gravity="center"
                android:text="‹"
                android:textColor="@color/gallery_detail_text"
                android:textSize="40sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/whiteboard_title"
                    android:textColor="@color/gallery_detail_text"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/detail_time"
                    android:textColor="#B3FFFFFF"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:gravity="center"
                android:text="⋮"
                android:textColor="@color/gallery_detail_text"
                android:textSize="28sp" />
        </LinearLayout>

        <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="300dp">

            <ImageView
                android:id="@+id/whiteboard_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Whiteboard der Projektsitzung"
                android:scaleType="centerCrop"
                android:src="@drawable/photo_whiteboard" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="70dp"
                android:paddingEnd="70dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#D9FFFFFF"
                    android:padding="8dp"
                    android:text="@string/task_tuesday"
                    android:textColor="#263238"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="#D9FFFFFF"
                    android:padding="8dp"
                    android:text="@string/task_thursday"
                    android:textColor="#263238"
                    android:textSize="21sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>

        <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingBottom="8dp">

            <TextView style="@style/GalleryDetailAction" android:text="@string/share" />
            <TextView style="@style/GalleryDetailAction" android:text="@string/edit" />
            <TextView style="@style/GalleryDetailAction" android:text="@string/delete" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
