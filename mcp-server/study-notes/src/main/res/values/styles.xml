<resources>
    <style name="NoteCardTitle">
        <item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/notes_text</item><item name="android:textSize">16sp</item><item name="android:textStyle">bold</item>
    </style>
    <style name="NoteCardBody">
        <item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">10dp</item><item name="android:textColor">@color/notes_text</item><item name="android:textSize">14sp</item><item name="android:lineSpacingExtra">3dp</item>
    </style>
    <style name="NoteCardMeta">
        <item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">14dp</item><item name="android:textColor">@color/notes_muted</item><item name="android:textSize">12sp</item>
    </style>
</resources>
