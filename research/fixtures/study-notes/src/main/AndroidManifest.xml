<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:label="@string/app_name" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher_round" android:theme="@style/Theme.AppCompat.DayNight.NoActionBar">
        <activity android:name=".StudyNotesActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <receiver android:name=".StudyNotesResetReceiver" android:exported="true">
            <intent-filter><action android:name="com.caddie.studynotes.ACTION_RESET" /></intent-filter>
        </receiver>
    </application>
</manifest>
