<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/modes_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/calendar_background"
    android:padding="24dp">

    <LinearLayout
        android:id="@+id/modes_summary_screen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/modes_title"
            android:textColor="@color/calendar_text_primary"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/modes_description"
            android:textColor="@color/calendar_text_secondary"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/modes_rule_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:background="@drawable/bg_calendar_event"
            android:minHeight="96dp"
            android:gravity="center_vertical"
            android:padding="18dp"
            android:text="@string/no_dnd_rule"
            android:textColor="@color/calendar_background"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/create_dnd_rule"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_calendar_event"
            android:gravity="center"
            android:text="@string/create_dnd_rule"
            android:textColor="@color/calendar_background"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/modes_editor_screen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/edit_exam_rule"
            android:textColor="@color/calendar_text_primary"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/tomorrow_exam"
            android:textColor="@color/calendar_text_secondary"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Beginn"
            android:textColor="@color/calendar_text_secondary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/dnd_start_time"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_calendar_input"
            android:contentDescription="Beginn der Nicht-stören-Regel"
            android:hint="HH:MM"
            android:imeOptions="actionDone"
            android:inputType="time"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:selectAllOnFocus="true"
            android:singleLine="true"
            android:textColor="@color/calendar_text_primary"
            android:textColorHint="@color/calendar_text_secondary"
            android:textSize="20sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Ende"
            android:textColor="@color/calendar_text_secondary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/dnd_end_time"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_calendar_input"
            android:contentDescription="Ende der Nicht-stören-Regel"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@color/calendar_text_primary"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/save_dnd_rule"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_calendar_event"
            android:gravity="center"
            android:text="@string/save_dnd_rule"
            android:textColor="@color/calendar_background"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
