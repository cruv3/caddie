<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/calendar_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/calendar_background">

    <FrameLayout
        android:id="@+id/schedule_screen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/calendar_background">

        <ScrollView
            android:id="@+id/schedule_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:paddingBottom="88dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <TextView
                        android:id="@+id/month_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:textColor="@color/calendar_text_primary"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/today_action"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:clickable="true"
                        android:contentDescription="Zum heutigen Datum"
                        android:focusable="true"
                        android:gravity="center"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="Heute"
                        android:textColor="@color/calendar_event_blue"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/weekday_header"
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <TextView style="@style/CalendarWeekday" android:text="M" />
                    <TextView style="@style/CalendarWeekday" android:text="D" />
                    <TextView style="@style/CalendarWeekday" android:text="M" />
                    <TextView style="@style/CalendarWeekday" android:text="D" />
                    <TextView style="@style/CalendarWeekday" android:text="F" />
                    <TextView style="@style/CalendarWeekday" android:text="S" />
                    <TextView style="@style/CalendarWeekday" android:text="S" />
                </LinearLayout>

                <GridLayout
                    android:id="@+id/month_grid"
                    android:layout_width="match_parent"
                    android:layout_height="324dp"
                    android:columnCount="7"
                    android:importantForAccessibility="noHideDescendants"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:rowCount="6" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/calendar_border" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="20dp"
                    android:paddingTop="20dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="12dp"
                    android:text="Nächste Termine"
                    android:textColor="@color/calendar_text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="12dp">

                    <LinearLayout
                        android:layout_width="48dp"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/today_weekday"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:textColor="@color/calendar_event_blue"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/today_number"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/bg_date_circle"
                            android:gravity="center"
                            android:textColor="@color/calendar_surface"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/meeting_event"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_calendar_agenda_event"
                        android:contentDescription="@string/meeting_title"
                        android:minHeight="64dp"
                        android:orientation="vertical"
                        android:paddingStart="14dp"
                        android:paddingTop="11dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="11dp">

                        <TextView
                            android:id="@+id/meeting_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/meeting_title"
                            android:textColor="@color/calendar_text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/meeting_time"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:textColor="@color/calendar_text_secondary"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="24dp">

                    <LinearLayout
                        android:layout_width="48dp"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tomorrow_weekday"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:textColor="@color/calendar_text_secondary"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tomorrow_number"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_marginTop="4dp"
                            android:gravity="center"
                            android:textColor="@color/calendar_text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/exam_event"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_calendar_agenda_event"
                        android:contentDescription="@string/exam_title"
                        android:minHeight="64dp"
                        android:orientation="vertical"
                        android:paddingStart="14dp"
                        android:paddingTop="11dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="11dp">

                        <TextView
                            android:id="@+id/exam_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/exam_title"
                            android:textColor="@color/calendar_text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/exam_time"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:textColor="@color/calendar_text_secondary"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <TextView
            android:id="@+id/create_event"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="end|bottom"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_calendar_fab"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:text="@string/plus_symbol"
            android:textColor="@color/calendar_surface"
            android:textSize="30sp" />

    </FrameLayout>

    <LinearLayout
        android:id="@+id/detail_screen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/calendar_background"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="20dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/detail_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:textColor="@color/calendar_text_primary"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/detail_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:textColor="@color/calendar_text_secondary"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/detail_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/calendar_text_primary"
            android:textSize="20sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/calendar_name"
            android:textColor="@color/calendar_text_secondary"
            android:textSize="16sp" />

        <Space
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/edit_event"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_calendar_event"
            android:contentDescription="@string/edit_event"
            android:gravity="center"
            android:text="@string/edit_event"
            android:textColor="@color/calendar_background"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/editor_screen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/calendar_background"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="20dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/editor_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/edit_meeting"
            android:textColor="@color/calendar_text_primary"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Beginn"
            android:textColor="@color/calendar_text_secondary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/start_time"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_calendar_input"
            android:contentDescription="Beginn"
            android:gravity="center_vertical"
            android:hint="HH:MM"
            android:imeOptions="actionDone"
            android:inputType="time"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:selectAllOnFocus="true"
            android:singleLine="true"
            android:textColor="@color/calendar_text_primary"
            android:textColorHint="@color/calendar_text_secondary"
            android:textSize="20sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Ende"
            android:textColor="@color/calendar_text_secondary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/end_time"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_calendar_input"
            android:contentDescription="Ende"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@color/calendar_text_primary"
            android:textSize="20sp" />

        <Space
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/save_event"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_calendar_event"
            android:contentDescription="@string/save_event"
            android:gravity="center"
            android:text="@string/save_event"
            android:textColor="@color/calendar_background"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>

</FrameLayout>
